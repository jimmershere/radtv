# Proton OpenVPN/IKEv2 credentials for Gluetun (NOT your Proton login email).
# Get these at: https://account.proton.me/vpn/OpenVPN
#
# Copy to floor2 (never commit real values):
#   scp wg.env floor2:/tmp/wg.env && chmod 600 /tmp/wg.env
#
# Then:
#   PROTON_CREDENTIALS_ENV=/tmp/wg.env PROTON_WG_CONF=/tmp/floor2-CH-262.conf ./radtv repair import-wg

userid=your_openvpn_username_here
password=your_openvpn_password_here
